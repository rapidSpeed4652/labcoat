[node name="Terminal_Apollo" parent="Act1_ControlRoom" unique_id=111796858 instance=ExtResource("9_tap")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.5, 0.95, 0)
tape_title = "Archive 11-A: Project Apollo LRRR"
tape_transcript = "BASE TRANQUILLITATIS LUNAR RANGING ARCHIVE (1969-1974)
In July 1969, the Apollo 11 crew placed the quartz retroreflector array at Mare Tranquillitatis. For five years, we fired ruby lasers from this station to measure lunar distance down to centimeters. During the October eclipse calibration, the Coude emitter recorded an anomalous return photon signature. The return signal stabilized into an active optical conduit, and shadow silhouettes began moving in unreflected dark spaces across the facility."
tape_voice_clip = "vocal_warning"


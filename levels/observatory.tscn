[node name="Terminal_Apollo" parent="Act1_ControlRoom" instance=ExtResource("9_tap")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.5, 0.95, 0)
tape_title = "Archive 11-A: Project Apollo LRRR"
tape_transcript = "BASE TRANQUILLITATIS LUNAR RANGING ARCHIVE (1969-1979)\nIn July 1969, Apollo 11 astronauts Armstrong and Aldrin placed the first 100-corner-cube quartz retroreflector at Mare Tranquillitatis. For a decade, we fired ruby lasers from Earth to measure lunar distance down to centimeters. During the solar eclipse, Dr. Vance rotated our Coude emitter toward the deep Perseus Void. The pulse was returned by something in the dark... and it used our beam as a bridge to cross into the station."
tape_voice_clip = "vocal_warning"


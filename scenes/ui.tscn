[connection signal="pressed" from="Control/PauseMenu/Center/VBox/ResumeBtn" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Control/PauseMenu/Center/VBox/RestartBtn" to="." method="_on_restart_button_pressed"]
[connection signal="toggled" from="Control/PauseMenu/Center/VBox/CrtToggle" to="." method="_on_crt_toggle_toggled"]
[connection signal="pressed" from="Control/PauseMenu/Center/VBox/QuitBtn" to="." method="_on_quit_button_pressed"]
[connection signal="pressed" from="Control/DeathScreen/Center/VBox/RestartBtn" to="." method="_on_restart_button_pressed"]

[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui.gd" id="1_ui"]
[ext_resource type="Shader" path="res://assets/shaders/crt_postprocess.gdshader" id="2_crt"]
[ext_resource type="Texture2D" path="res://assets/textures/polaroid.png" id="3_pol"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = ExtResource("2_crt")
shader_parameter/scanline_count = 360.0
shader_parameter/scanline_intensity = 0.12
shader_parameter/vignette_intensity = 0.65
shader_parameter/aberration_amount = 0.002
shader_parameter/static_noise = 0.025

[node name="UI" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_ui")

[node name="Control" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="CRTOverlay" type="ColorRect" parent="Control"]
material = SubResource("ShaderMaterial_crt")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Crosshair" type="CenterContainer" parent="Control"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Dot" type="ColorRect" parent="Control/Crosshair"]
custom_minimum_size = Vector2(4, 4)
layout_mode = 2
color = Color(0.2, 0.9, 1, 0.8)

[node name="PromptLabel" type="Label" parent="Control"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = 30.0
offset_right = 250.0
offset_bottom = 70.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(1, 0.9, 0.4, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 18
text = "[E] Interact"
horizontal_alignment = 1

[node name="ObjectivePanel" type="PanelContainer" parent="Control"]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -320.0
offset_top = 20.0
offset_right = 320.0
offset_bottom = 65.0
grow_horizontal = 2

[node name="ObjectiveLabel" type="Label" parent="Control/ObjectivePanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 1, 0.6, 1)
theme_override_font_sizes/font_size = 15
text = "OBJECTIVE: Inspect the observatory."
horizontal_alignment = 1
vertical_alignment = 1

[node name="LaserPanel" type="VBoxContainer" parent="Control"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -260.0
offset_top = -90.0
offset_right = -30.0
offset_bottom = -30.0
grow_horizontal = 0
grow_vertical = 0

[node name="HeatLabel" type="Label" parent="Control/LaserPanel"]
layout_mode = 2

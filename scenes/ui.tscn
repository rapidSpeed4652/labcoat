[connection signal="pressed" from="Control/PauseMenu/Center/VBox/ResumeBtn" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Control/PauseMenu/Center/VBox/RestartBtn" to="." method="_on_restart_button_pressed"]

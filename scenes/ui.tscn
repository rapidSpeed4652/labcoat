[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/ui.gd" id="1_ui"]
[ext_resource type="Shader" path="res://assets/shaders/crt_postprocess.gdshader" id="2_crt"]
[ext_resource type="Texture2D" path="res://assets/textures/polaroid.png" id="3_pol"]
[ext_resource type="Script" path="res://scripts/minimap.gd" id="4_map"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = ExtResource("2_crt")
shader_parameter/scanline_count = 360.0
shader_parameter/scanline_intensity = 0.12
shader_parameter/vignette_intensity = 0.65
shader_parameter/aberration_amount = 0.002
shader_parameter/static_noise = 0.025

[node name="UI" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_ui")

[node name="Control" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="CRTOverlay" type="ColorRect" parent="Control"]
material = SubResource("ShaderMaterial_crt")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; Dynamic Targeting Reticle
[node name="Crosshair" type="HBoxContainer" parent="Control"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -30.0
offset_top = -15.0
offset_right = 30.0
offset_bottom = 15.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1
mouse_filter = 2

[node name="BracketL" type="Label" parent="Control/Crosshair"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 20
text = "["

[node name="Dot" type="ColorRect" parent="Control/Crosshair"]
custom_minimum_size = Vector2(4, 4)
layout_mode = 2
size_flags_vertical = 4
color = Color(0.2, 0.9, 1, 0.6)

[node name="BracketR" type="Label" parent="Control/Crosshair"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 20
text = "]"

; Object Identification & Action Card
[node name="TargetCard" type="PanelContainer" parent="Control"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = 28.0
offset_right = 260.0
offset_bottom = 118.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Control/TargetCard"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="BadgeLabel" type="Label" parent="Control/TargetCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.9, 1, 1)
theme_override_font_sizes/font_size = 13
text = "⚡ [EQUIPMENT: MODEL 74 EMITTER]"
horizontal_alignment = 1

[node name="ActionLabel" type="Label" parent="Control/TargetCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.95, 0.7, 1)
theme_override_font_sizes/font_size = 17
text = "[E] Pick up Handheld Alignment Laser"
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="Control/TargetCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.82, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Raw beam absorbs into shadows. Bounce beam off mirrors to banish."
horizontal_alignment = 1
autowrap_mode = 3

; Objective Panel
[node name="ObjectivePanel" type="PanelContainer" parent="Control"]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -340.0
offset_top = 20.0
offset_right = 340.0
offset_bottom = 65.0
grow_horizontal = 2

[node name="ObjectiveLabel" type="Label" parent="Control/ObjectivePanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 1, 0.6, 1)
theme_override_font_sizes/font_size = 15
text = "OBJECTIVE: Inspect the observatory."
horizontal_alignment = 1
vertical_alignment = 1

; Laser Heat Panel
[node name="LaserPanel" type="VBoxContainer" parent="Control"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -260.0
offset_top = -90.0
offset_right = -30.0
offset_bottom = -30.0
grow_horizontal = 0
grow_vertical = 0

[node name="HeatLabel" type="Label" parent="Control/LaserPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.9, 1, 1)
theme_override_font_sizes/font_size = 13
text = "EMITTER HEAT: 0%"
horizontal_alignment = 2

[node name="HeatBar" type="ProgressBar" parent="Control/LaserPanel"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
value = 20.0
show_percentage = false

; Portable Mirror Count
[node name="MirrorPanel" type="PanelContainer" parent="Control"]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 30.0
offset_top = -70.0
offset_right = 330.0
offset_bottom = -30.0
grow_vertical = 0

[node name="MirrorLabel" type="Label" parent="Control/MirrorPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.9, 0.5, 1)
theme_override_font_sizes/font_size = 13
text = "PORTABLE MIRRORS: 1 [RMB PLACE]"
vertical_alignment = 1

; Persistent Corner Minimap
[node name="MinimapPanel" type="PanelContainer" parent="Control"]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -215.0
offset_top = 18.0
offset_right = -18.0
offset_bottom = 225.0
grow_horizontal = 0

[node name="VBox" type="VBoxContainer" parent="Control/MinimapPanel"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="HeaderLabel" type="Label" parent="Control/MinimapPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.9, 1, 1)
theme_override_font_sizes/font_size = 11
text = "SECTOR RADAR [M / TAB]"
horizontal_alignment = 1

[node name="MinimapDisplay" type="Control" parent="Control/MinimapPanel/VBox"]
custom_minimum_size = Vector2(190, 165)
layout_mode = 2
script = ExtResource("4_map")

[node name="LegendLabel" type="Label" parent="Control/MinimapPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 0.9, 0.8)
theme_override_font_sizes/font_size = 9
text = "● YOU  ◆ CAP(3)  ✦ SENSOR"
horizontal_alignment = 1

; Radio Dialogue Box
[node name="RadioBox" type="PanelContainer" parent="Control"]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -350.0
offset_top = -140.0
offset_right = 350.0
offset_bottom = -50.0
grow_horizontal = 2
grow_vertical = 0

[node name="VBox" type="VBoxContainer" parent="Control/RadioBox"]
layout_mode = 2

[node name="SpeakerLabel" type="Label" parent="Control/RadioBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)
theme_override_font_sizes/font_size = 14
text = "[ TRANSMISSION: SUPERVISOR CHEN ]"

[node name="MessageLabel" type="Label" parent="Control/RadioBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_font_sizes/font_size = 14
text = "Leo, shut down the capacitors and get out!"
autowrap_mode = 3

; Fullscreen Polaroid Inspector
[node name="PolaroidModal" type="ColorRect" parent="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.88)

[node name="Center" type="CenterContainer" parent="Control/PolaroidModal"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Control/PolaroidModal/Center"]
layout_mode = 2
alignment = 1

[node name="TextureRect" type="TextureRect" parent="Control/PolaroidModal/Center/VBox"]
custom_minimum_size = Vector2(400, 480)
layout_mode = 2
texture = ExtResource("3_pol")
expand_mode = 1
stretch_mode = 5

[node name="CloseLabel" type="Label" parent="Control/PolaroidModal/Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.9, 0.4, 1)
theme_override_font_sizes/font_size = 16
text = "[E / CLICK / ESC] Put Down Polaroid"
horizontal_alignment = 1

; Fullscreen Facility Schematic Map
[node name="FullMapModal" type="ColorRect" parent="Control"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.02, 0.04, 0.92)

[node name="Center" type="CenterContainer" parent="Control/FullMapModal"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Control/FullMapModal/Center"]
custom_minimum_size = Vector2(920, 600)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Control/FullMapModal/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Control/FullMapModal/Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.95, 1, 1)
theme_override_font_sizes/font_size = 18
text = "TRANQUILLITATIS LUNAR RESEARCH BASE // FACILITY SCHEMATIC"
horizontal_alignment = 1

[node name="SubLabel" type="Label" parent="Control/FullMapModal/Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.85, 0.9, 0.7)
theme_override_font_sizes/font_size = 12
text = "APOLLO 11 / LRRR COUDÉ EXPANSION // SECTOR BLUEPRINT & TELEMETRY"
horizontal_alignment = 1

[node name="ContentHBox" type="HBoxContainer" parent="Control/FullMapModal/Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="MapContainer" type="VBoxContainer" parent="Control/FullMapModal/Center/Panel/VBox/ContentHBox"]
custom_minimum_size = Vector2(500, 480)
layout_mode = 2

[node name="FullMapDisplay" type="Control" parent="Control/FullMapModal/Center/Panel/VBox/ContentHBox/MapContainer"]
custom_minimum_size = Vector2(500, 470)
layout_mode = 2
script = ExtResource("4_map")
is_fullscreen_map = true

[node name="Sidebar" type="VBoxContainer" parent="Control/FullMapModal/Center/Panel/VBox/ContentHBox"]
custom_minimum_size = Vector2(380, 480)
layout_mode = 2
theme_override_constants/separation = 12

[node name="ChecklistLabel" type="Label" parent="Control/FullMapModal/Center/Panel/VBox/ContentHBox/Sidebar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 1, 0.6, 1)
theme_override_font_sizes/font_size = 13
text = "MISSION CHECKLIST & TELEMETRY:\n\n[ ] Equipment: Model 74 Alignment Laser\n[ ] Sector 1 Sensor: LOCKED\n[ ] Bay A Capacitor: ONLINE\n[ ] Bay B Capacitor: ONLINE\n[ ] Bay C Capacitor: ONLINE\n[ ] Dome Blast Doors: SEALED\n[ ] Coudé Optical Triangle: PENDING\n[ ] Primary Shutter: JAMMED OPEN"
autowrap_mode = 3

[node name="SectorLegend" type="Label" parent="Control/FullMapModal/Center/Panel/VBox/ContentHBox/Sidebar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.6, 1)
theme_override_font_sizes/font_size = 12
text = "SECTOR DIRECTORY:\n• CMD: Operations & Observation Deck\n• H1/H2: Sub-surface Optical Corridors\n• BAY A: South High-Voltage Capacitor\n• BAY B: West Laser Transformer\n• BAY C: East Regolith Physics Lab\n• DOME: Primary Coudé Telescope\n• EXIT: Lunar Surface Airlock"
autowrap_mode = 3

[node name="CloseButton" type="Button" parent="Control/FullMapModal/Center/Panel/VBox/ContentHBox/Sidebar"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "[M / TAB / ESC] RETURN TO HUD"


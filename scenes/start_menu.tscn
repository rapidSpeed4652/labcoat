[node name="ControlsList" type="RichTextLabel" parent="UI/ControlsModal/Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 310)
layout_mode = 2
theme_override_font_sizes/normal_font_size = 15
bbcode_enabled = true
text = "WASD / Arrow Keys — EVA Mobility (Forward, Left, Back, Right)
Mouse Movement — Optics Pitch & Yaw Aiming
Left Mouse Button (Hold) — Fire Handheld Alignment Laser
Right Mouse Button / Q — Deploy / Retrieve Portable Mirror
E / F — Interact (Examine Polaroid, Play Tape Logs, Flip Breakers, Pull Lever)
M / TAB — Toggle Tactical Facility Schematic Map
Shift (Hold) — Sprint Propulsion
Space — Low-Gravity Leap
R — Emergency Checkpoint Reset
Escape — Pause Station Systems / Close Modals"


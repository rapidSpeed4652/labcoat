[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/start_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://assets/textures/lunar_skybox.png" id="2_sky"]
[ext_resource type="Texture2D" path="res://assets/textures/polaroid.png" id="3_pol"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn"]
bg_color = Color(0.12, 0.16, 0.22, 0.9)
border_width_left = 3
border_width_top = 1
border_width_right = 1
border_width_bottom = 3
border_color = Color(0.3, 0.7, 1.0, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.06, 0.08, 0.12, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.8, 1.0, 0.8)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="StartMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

; Background Skybox Vista
[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_sky")
expand_mode = 1
stretch_mode = 6

; Darkened Vignette Overlay
[node name="Vignette" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.04, 0.08, 0.7)

; Main Menu Content
[node name="TitleBox" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 80.0
offset_top = 80.0
offset_right = 720.0
offset_bottom = 240.0

[node name="Badge" type="Label" parent="TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.8, 1.0, 1)
theme_override_font_sizes/font_size = 14
text = "[NASA / LURE EXPEDITION 77 // LUNAR LASER RANGING]"

[node name="Title" type="Label" parent="TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1.0, 1.0, 1.0, 1)
theme_override_font_sizes/font_size = 54
text = "RETRO-REFLECTOR"

[node name="Subtitle" type="Label" parent="TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1.0, 0.75, 0.2, 1)
theme_override_font_sizes/font_size = 18
text = "MOUNT HALE LUNAR OBSERVATORY // DEEP SPACE ANOMALY"

[node name="Status" type="Label" parent="TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.3, 0.3, 1)
theme_override_font_sizes/font_size = 13
text = "STATUS: PRIMARY SHUTTER OPEN • COUDÉ LASER FIRING • OPTICAL BREACH ACTIVE"

; Button Menu
[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 80.0
offset_top = 280.0
offset_right = 440.0
offset_bottom = 540.0
theme_override_constants/separation = 16

[node name="BtnStart" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(0.3, 1, 0.6, 1)
theme_override_font_sizes/font_size = 18
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
text = "▶  COMMENCE OPERATION"

[node name="BtnDossier" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
theme_override_font_sizes/font_size = 16
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
text = "📁  MISSION DOSSIER"

[node name="BtnControls" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
theme_override_font_sizes/font_size = 16
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")

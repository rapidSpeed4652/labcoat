[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/start_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://assets/textures/lunar_skybox.png" id="2_sky"]

[sub_resource type="PanoramaSkyMaterial" id="PanoramaSkyMaterial_lunar"]
panorama = ExtResource("2_sky")

[sub_resource type="Sky" id="Sky_lunar"]
sky_material = SubResource("PanoramaSkyMaterial_lunar")

[sub_resource type="Environment" id="Environment_menu"]
background_mode = 2
sky = SubResource("Sky_lunar")
ambient_light_source = 3
ambient_light_color = Color(0.12, 0.16, 0.24, 1)
ambient_light_energy = 0.8
tonemap_mode = 2
glow_enabled = true
glow_intensity = 1.2
glow_bloom = 0.3
volumetric_fog_enabled = true
volumetric_fog_density = 0.02
volumetric_fog_albedo = Color(0.85, 0.95, 1.0, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn"]
bg_color = Color(0.08, 0.12, 0.18, 0.92)
border_width_left = 3
border_width_top = 1
border_width_right = 1
border_width_bottom = 3
border_color = Color(0.2, 0.8, 1.0, 0.85)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.04, 0.06, 0.1, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.85, 1.0, 0.9)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="StartMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

; === 3D VISTA ENVIRONMENT ===
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_menu")

[node name="DirectionalMoonlight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.353553, 0.353553, 0, 0.707107, 0.707107, -0.5, -0.612372, 0.612372, 0, 20, 0)
light_color = Color(0.38, 0.55, 0.82, 1)
light_energy = 0.6
shadow_enabled = true

; Smooth Orbiting 3D Camera Pivot
[node name="CameraPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.5, 0)

[node name="Camera3D" type="Camera3D" parent="CameraPivot"]
transform = Transform3D(1, 0, 0, 0, 0.939693, 0.34202, 0, -0.34202, 0.939693, 0, 8.0, 24.0)
current = true

; Diorama Lunar Terrain in Background
[node name="MenuLunarGround" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
size = Vector3(80, 1.0, 80)

[node name="MenuDomePylon" type="CSGCylinder3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.8, 0)
radius = 4.5
height = 3.6

[node name="MenuBeam" type="CSGCylinder3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 25.0, 0)
radius = 0.15
height = 50.0

[node name="BeamGlow" type="OmniLight3D" parent="MenuBeam"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -20.0, 0)
light_color = Color(0.1, 0.9, 1.0, 1)
light_energy = 5.0
omni_range = 14.0

